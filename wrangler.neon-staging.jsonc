{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordloop-neon-staging",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://jgzzrlnmakllhurjiazh.supabase.co",
    "DEV_USER_ID": "32903a88-9955-4b3e-b7ad-47623764cb25",
    "WORDLOOP_STAGING_DIAGNOSTICS": "true",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P1lM0vqrWtO23O8VoJTabQ_FI-Dsuo0",
