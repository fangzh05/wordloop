{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordloop-app",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "test.zehaoo.top",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://jgzzrlnmakllhurjiazh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P1lM0vqrWtO23O8VoJTabQ_FI-Dsuo0"
  },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api/*"]
  }
}
