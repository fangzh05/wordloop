{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordloop-app",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api/*"]
  }
}
